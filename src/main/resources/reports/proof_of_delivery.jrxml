<!-- RDC copy of the core fulfillment Proof of Delivery print template
     (openlmis-fulfillment v9.4.0, src/main/resources/jasperTemplates/proofOfDelivery.jrxml).
     Differences: shipped quantity in packs and in doses, column widths that fit the RDC labels,
     header cells that grow together with 3 px of vertical padding, and the title pattern key
     report.title.proofOfDeliveryForProgram (the RDC bundles' proofOfDeliveryFor has no {0}).
     The report service fills it in place of the core template that fulfillment sends to
     /api/reports/generate, after fulfillment has checked the PoD view rights, so it takes the same
     parameters as the core template. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="proofOfDelivery" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenResourceMissingType="Empty" uuid="c9b88bba-e685-4f37-89f1-8175e056a730">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<import value="java.time.ZonedDateTime"/>
	<import value="java.time.LocalDate"/>
	<import value="java.time.format.DateTimeFormatter"/>
	<import value="java.text.DecimalFormat"/>
	<import value="java.time.ZoneId"/>
	<parameter name="id">
		<property name="displayName" value="Proof of Delivery"/>
	</parameter>
	<parameter name="decimalFormat" class="java.text.DecimalFormat" isForPrompting="false">
		<property name="displayName" value="DecimalFormat"/>
	</parameter>
	<parameter name="dateTimeFormat" isForPrompting="false">
		<property name="displayName" value="DateTimeFormat"/>
	</parameter>
	<parameter name="dateFormat" isForPrompting="false">
		<property name="displayName" value="DateFormat"/>
	</parameter>
	<parameter name="timeZoneId" isForPrompting="false">
		<property name="displayName" value="TimeZoneId"/>
	</parameter>
    <parameter name="headerTemplate" class="net.sf.jasperreports.engine.JasperReport" isForPrompting="false">
        <property name="displayName" value="HeaderTemplate"/>
    </parameter>
	<queryString language="SQL">
		<![CDATA[select distinct on (orderProductName, productname, lotcode)
  p."name" as programName,
  ord.ordercode as orderCode,
  ord.status as orderStatus,
  ordering_facility.code as orderingFacilityCode,
  ordering_facility."name" as orderingFacility,
  ord.createddate as orderDate,
  pp.startdate as periodStartDate,
  pp.enddate as periodEndDate,
  supplying_facility."name" as supplyingFacility,
  orderable.fullproductname as productName,
  order_orderable.fullproductname as orderProductName,
  COALESCE(NULLIF(Concat_ws(',', size_code.value, route_of_administration.value),
    ''), dispensing_unit.value) as productUnit,
  order_li.orderedquantity as quantityOrdered,
  shipment_li.quantityshipped as quantityShipped,
  shipment_li.quantityshipped * orderable.netcontent as quantityShippedDoses,
  lot.lotcode as lotCode,
  pod_li.quantityaccepted as quantityAccepted,
  pod_li.vvmstatus as vvmStatus,
  pod_li.quantityrejected as quantityReturned,
  rejection_reason."name" as rejectionReason,
  pod_li.notes as notes,
  pod.deliveredby as deliveredBy,
  pod.receivedby as receivedBy,
  pod.receiveddate as receivedDate
from fulfillment.proofs_of_delivery pod
join fulfillment.shipments shipment on shipment.id = pod.shipmentid
join fulfillment.orders ord on ord.id = shipment.orderid
join referencedata.programs p on p.id = ord.programid
join referencedata.facilities ordering_facility on ordering_facility.id = ord.receivingfacilityid
join referencedata.facilities supplying_facility on supplying_facility.id = ord.supplyingfacilityid
left join referencedata.processing_periods pp on pp.id = ord.processingperiodid
left join fulfillment.proof_of_delivery_line_items pod_li on pod_li.proofofdeliveryid = pod.id
left join referencedata.orderables orderable on orderable.id = pod_li.orderableid and orderable.versionnumber = pod_li.orderableversionnumber
left join referencedata.dispensables dispensable on dispensable.id = orderable.dispensableid
left join referencedata.orderable_identifiers pod_orderable_identifier on orderable.id = pod_orderable_identifier.orderableid
  and pod_orderable_identifier.orderableversionnumber = pod_li.orderableversionnumber
left join fulfillment.order_line_items order_li on order_li.orderid = ord.id
    and pod_li.orderableid = order_li.orderableid and pod_li.orderableversionnumber = order_li.orderableversionnumber
left join fulfillment.shipment_line_items shipment_li on shipment_li.shipmentid = shipment.id
  and pod_li.orderableid = shipment_li.orderableid and pod_li.orderableversionnumber = shipment_li.orderableversionnumber
  and ((pod_li.lotid is null and shipment_li.lotid is null) or pod_li.lotid = shipment_li.lotid)
left join referencedata.dispensable_attributes dispensing_unit on dispensing_unit.dispensableid = dispensable.id
  and dispensing_unit."key" = 'dispensingUnit'
left join referencedata.dispensable_attributes route_of_administration on route_of_administration.dispensableid = dispensable.id
  and route_of_administration."key" = 'routeOfAdministration'
left join referencedata.dispensable_attributes size_code on size_code.dispensableid = dispensable.id
  and size_code."key" = 'sizeCode'
left join referencedata.lots lot on pod_li.lotid = lot.id
left join stockmanagement.stock_card_line_item_reasons rejection_reason on rejection_reason.id = pod_li.rejectionreasonid
left join referencedata.orderables order_orderable on order_orderable.id = order_li.orderableid
  and order_orderable.versionnumber = order_li.orderableversionnumber
where pod.id = $P{id}::uuid
order by orderProductName, productName, lotCode desc]]>
	</queryString>
